# HPC Operations MCP Server Configuration

# Portal backend URL (internal)
PORTAL_API_URL=http://localhost:8000

# Job-API URL (internal)
JOB_API_URL=http://localhost:9000

# JWT secret (must match the portal backend's SECRET_KEY)
SECRET_KEY=

# JWT algorithm (must match the portal backend)
ALGORITHM=HS256

# Database (for audit logging — reads from the portal's DB)
MYSQL_SERVER=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=strach_portal

# Authentication toggle (set to "false" for local testing only)
MCP_REQUIRE_AUTH=true

# Audit logging toggle
MCP_AUDIT_ENABLED=true

# Slurm paths (must match the host system)
SLURM_PATH=/usr/local/slurm/bin:/usr/local/slurm/sbin
SLURM_LIB_PATH=/usr/local/slurm/lib
