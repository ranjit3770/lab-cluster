[Unit]
Description=Slurm Database Daemon
After=network.target munge.service mariadb.service
Requires=munge.service

[Service]
Type=simple
User=slurm
Group=slurm
ExecStart=/usr/local/slurm/sbin/slurmdbd -D
Restart=always
RestartSec=5
LimitNOFILE=65536
RuntimeDirectory=slurm

[Install]
WantedBy=multi-user.target
