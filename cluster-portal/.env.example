# Copy to .env and fill in real values. Never commit the populated .env.

# ---------------------------------------------------------------------------
# Database (MariaDB for portal identity + job registry)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# Dedicated account used by the Job-API service (provisioned at backend boot).
JOB_API_DB_USER=slurm_user
JOB_API_DB_PASSWORD=change-me-strong-jobapi-password

# ---------------------------------------------------------------------------
# Backend JWT signing
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-generate-with-python-c-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Slurm REST API
# ---------------------------------------------------------------------------
SLURM_REST_URL=http://127.0.0.1:6820/slurm/v0.0.41
SLURM_VERSION=v0.0.41
SLURM_JWT_USER=slurmapi

# ---------------------------------------------------------------------------
# Storage & deployment paths
# ---------------------------------------------------------------------------
DATA_STORAGE=/data_storage
CLUSTER_SETUP_DIR=/opt/amritacluster/lab-cluster

# ---------------------------------------------------------------------------
# Initial seeded accounts (first boot only; change after first login)
# ---------------------------------------------------------------------------
ADMIN_INITIAL_PASSWORD=change-me-admin-password
DEVELOPER_INITIAL_PASSWORD=change-me-developer-password

# ---------------------------------------------------------------------------
# CORS: comma-separated list of allowed browser origins (empty disables CORS)
# ---------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:5173

# Comma-separated list of node names allowed to run portal-submitted jobs.
PORTAL_SLURM_NODELIST=head-node

# ---------------------------------------------------------------------------
# Backups (scripts/backup_database.sh + restore_database.sh)
# ---------------------------------------------------------------------------
BACKUP_DIR=/var/backups/portal
DAILY_RETENTION_DAYS=7
WEEKLY_RETENTION_DAYS=28
# Encrypt archives at rest with GPG symmetric AES256:
BACKUP_GPG_PASSPHRASE=
# Push finished archives off-site via rsync (key-based SSH), e.g.:
#   backup@nas.example.edu:/srv/backups/portal
BACKUP_REMOTE_TARGET=
