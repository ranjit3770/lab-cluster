# Copy this file to .env in the same directory and adjust for your host.
# docker compose reads it automatically before substituting variables.

# Absolute path where SLURM-COMPLETE-SETUP lives on THIS machine.
# This is the single place to change when moving the deployment.
CLUSTER_SETUP_DIR=/opt/amritacluster/SLURM-COMPLETE-SETUP

# Database credentials (also used by backend/job-api defaults below).
MYSQL_ROOT_PASSWORD=Amma@123

# Comma-separated nodelist portal jobs may run on after shared storage is mounted.
# PORTAL_SLURM_NODELIST=head-node
